---
import Base from "../layouts/Base.astro";
import { SITE_NAME } from "../../site.config.mjs";
---

<Base title="Page not found" description={`That page is not on ${SITE_NAME}.`} path="/404" noindex={true}>
  <header class="page-head">
    <h1>That page is not here.</h1>
    <p><a href="/">Browse the listings</a></p>
  </header>
</Base>
